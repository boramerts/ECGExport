    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ECGExport needs access to your previously recorded Apple Watch ECG measurements to export them for research and analysis. All processing takes place on your device."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ECGExport, daha önce kaydedilmiş Apple Watch EKG ölçümlerinizi araştırma ve analiz amacıyla dışa aktarmak için erişim izninize ihtiyaç duyar. Tüm işlemler cihazınızda gerçekleştirilir."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ECGExport only reads existing ECG recordings. It does not add, modify, or delete health data."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ECGExport yalnızca mevcut EKG kayıtlarını dışa aktarmak amacıyla okur. Apple Sağlık verilerinizi eklemez, değiştirmez veya silmez."
          }
        }
      }
    }
  },
  "version" : "1.3"
}